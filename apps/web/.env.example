APP_URL=https://agenda.reffix.com.br

# Postgres
# Depois de preencher, rode: npm run db:create
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/agenda
DATABASE_SSL=0

# Asaas — produção (checkout real; sem botão "Simular pagamento")
# Cole SEM o $ do início (evita o dotenv apagar a chave):
# ASAAS_API_KEY=aact_prod_sua_chave_aqui
ASAAS_API_KEY=
ASAAS_USE_SANDBOX=false
ASAAS_ENV=production
ASAAS_API_URL=https://api.asaas.com/v3
# Obrigatório em produção (header asaas-access-token no webhook).
ASAAS_WEBHOOK_TOKEN=

# Webhook Asaas → https://agendaapi.reffix.com.br/api/billing/webhook
# Eventos: CHECKOUT_PAID, PAYMENT_RECEIVED, PAYMENT_CONFIRMED
# Produção: chave Pix cadastrada. Checkout = PIX avulso (30 dias).
