APP_URL=http://localhost:3010

# Postgres (produção / servidor). Sem isso, o app usa data/db.json local.
# Depois de preencher, rode: npm run db:create
DATABASE_URL=postgres://usuario:senha@127.0.0.1:5432/agenda
# Use 0 se o Postgres do servidor não exigir SSL
DATABASE_SSL=0

ASAAS_API_KEY=
ASAAS_USE_SANDBOX=true
ASAAS_ENV=sandbox
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
ASAAS_WEBHOOK_TOKEN=
